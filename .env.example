# ---------------------------------------------------------------------------
# HOM-COMPASS environment configuration
# Copy this file to `.env` and fill in the values.
#
# The app runs in a fully functional DEMO MODE when no Supabase credentials
# are supplied — it falls back to a bundled seed knowledge graph so you can
# explore repertorisation, materia medica and case-taking without a backend.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# The variables below are only used by the Supabase Edge Functions
# (server side). They are NOT exposed to the browser. Set them in the
# Supabase dashboard (Project Settings -> Edge Functions -> Secrets).
# ---------------------------------------------------------------------------

# Embedding provider: `openai` (default). 1536-dim vectors.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat/analysis provider for AI case analysis: `anthropic` or `openai`
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Service role key (server-side only, used by edge functions to write nodes)
SUPABASE_SERVICE_ROLE_KEY=
